  "components": [
    {
      "name": "Folder navigation row",
      "kind": "nav",
      "refersTo": "folder-selected-dark",
      "description": "Flat selected and hover states with a restrained 4px row corner and no surrounding card.",
      "html": "<div class=\"ds-themes\"><div class=\"ds-panel ds-dark\"><button class=\"ds-folder ds-folder-dark\" type=\"button\" aria-current=\"page\"><span>Inbox</span><span class=\"ds-count\">3</span></button></div><div class=\"ds-panel ds-light\"><button class=\"ds-folder ds-folder-light\" type=\"button\" aria-current=\"page\"><span>Inbox</span><span class=\"ds-count\">3</span></button></div></div>",
      "css": ".ds-themes{display:grid;grid-template-columns:1fr 1fr;gap:8px;font:13px Geist,sans-serif}.ds-panel{padding:8px;border-radius:4px}.ds-dark{background:#0d0d0d;color:#e8e8ea}.ds-light{background:#f7f7f9;color:#303035}.ds-folder{display:flex;width:100%;height:32px;align-items:center;justify-content:space-between;padding:0 8px;border:0;border-radius:4px;font:13px Geist,sans-serif;text-align:left;cursor:pointer}.ds-folder-dark{background:rgb(235 235 235 / 11%);color:#e8e8ea}.ds-folder-light{background:rgb(26 26 26 / 6%);color:#303035}.ds-count{font-size:11px;opacity:.82}.ds-folder-dark:hover{background:rgb(235 235 235 / 11%)}.ds-folder-light:hover{background:rgb(26 26 26 / 6%)}.ds-folder:focus-visible{outline:2px solid #7c86ff;outline-offset:2px}.ds-folder-light:focus-visible{outline-color:#5b43e8}"
    },
    {
      "name": "Selected message row",
      "kind": "custom",
      "refersTo": "message-row-selected-dark",
      "description": "78px three-line sender, subject, and snippet hierarchy with 4px corners and distinct selected/hover states.",
      "html": "<div class=\"ds-themes\"><div class=\"ds-list ds-dark\"><button class=\"ds-row ds-row-dark\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-first\"><span class=\"ds-dot\"></span><span class=\"ds-sender\">Maya Chen</span><span class=\"ds-time\">10:42 AM</span></span><span class=\"ds-subject\">The new identity system is ready</span><span class=\"ds-preview\">I pulled the final typography and color studies into one clear direction.</span></button></div><div class=\"ds-list ds-light\"><button class=\"ds-row ds-row-light\" type=\"button\" aria-pressed=\"true\"><span class=\"ds-first\"><span class=\"ds-dot\"></span><span class=\"ds-sender\">Maya Chen</span><span class=\"ds-time\">10:42 AM</span></span><span class=\"ds-subject\">The new identity system is ready</span><span class=\"ds-preview\">I pulled the final typography and color studies into one clear direction.</span></button></div></div>",
      "css": ".ds-themes{display:grid;grid-template-columns:1fr 1fr;gap:8px;font:13px Geist,sans-serif}.ds-list{padding:8px}.ds-dark{background:#090909;color:#e8e8ea}.ds-light{background:#fcfcfd;color:#303035}.ds-row{display:flex;box-sizing:border-box;width:100%;height:78px;flex-direction:column;justify-content:center;gap:4px;padding:8px 12px;border:0;border-radius:4px;text-align:left;font-family:Geist,sans-serif;cursor:pointer}.ds-row-dark{background:#2e2e30;color:#e8e8ea}.ds-row-light{background:#e8e8eb;color:#303035}.ds-first{display:flex;align-items:center;gap:8px}.ds-sender{flex:1;overflow:hidden;font-size:13px;font-weight:600;white-space:nowrap}.ds-time,.ds-preview{color:#a9a9ae;font-size:10px}.ds-light .ds-time,.ds-light .ds-preview{color:#62626a}.ds-dot{width:6px;height:6px;border-radius:9999px;background:#7c86ff}.ds-light .ds-dot{background:#5b43e8}.ds-subject{overflow:hidden;font-size:12px;font-weight:500;text-overflow:ellipsis;white-space:nowrap}.ds-preview{overflow:hidden;font-size:11px;text-overflow:ellipsis;white-space:nowrap}.ds-row-dark:hover{background:#252527}.ds-row-light:hover{background:#efeff2}.ds-row:focus-visible{outline:2px solid #7c86ff;outline-offset:1px}.ds-row-light:focus-visible{outline-color:#5b43e8}"
    },
    {
      "name": "Message search input",
      "kind": "input",
      "refersTo": "input-search-dark",
      "description": "Search and filters operate on loaded messages in the current folder; they do not query the server-wide mailbox.",
      "html": "<div class=\"ds-themes\"><label class=\"ds-search ds-dark\"><svg class=\"ds-search-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"></circle><path d=\"m10.5 10.5 3 3\"></path></svg><input type=\"search\" aria-label=\"Search sample messages\" placeholder=\"Search sample mail\"><button class=\"ds-clear\" type=\"button\" aria-label=\"Clear search\">×</button></label><label class=\"ds-search ds-light\"><svg class=\"ds-search-icon\" viewBox=\"0 0 16 16\" aria-hidden=\"true\"><circle cx=\"7\" cy=\"7\" r=\"4.5\"></circle><path d=\"m10.5 10.5 3 3\"></path></svg><input type=\"search\" aria-label=\"Search sample messages\" placeholder=\"Search sample mail\"><button class=\"ds-clear\" type=\"button\" aria-label=\"Clear search\">×</button></label></div>",
      "css": ".ds-themes{display:grid;gap:8px;font:14px Geist,sans-serif}.ds-search{display:flex;height:32px;align-items:center;gap:8px;padding:0 10px;border:1px solid #202020;border-radius:8px;background:#0e0e0e;color:#e8e8ea}.ds-search.ds-light{border-color:#e5e5e9;background:#fff;color:#303035}.ds-search-icon{width:14px;height:14px;flex:none;fill:none;stroke:#85858a;stroke-width:1.5}.ds-light .ds-search-icon{stroke:#73737a}.ds-search input{min-width:0;flex:1;border:0;outline:0;background:transparent;color:inherit;font:14px Geist,sans-serif}.ds-search input::placeholder{color:#a9a9ae}.ds-light input::placeholder{color:#62626a}.ds-clear{border:0;background:transparent;color:inherit;font-size:16px;cursor:pointer}.ds-search:focus-within{outline:2px solid #7c86ff;outline-offset:1px}.ds-search.ds-light:focus-within{outline-color:#5b43e8}"
    },
    {
      "name": "Archive or restore button",
      "kind": "button",
      "refersTo": "button-secondary-dark",
      "description": "Compact secondary action with a native icon, hover state, and visible keyboard focus.",
      "html": "<div class=\"ds-themes\"><div class=\"ds-button-stage ds-dark\"><button class=\"ds-action ds-action-dark\" type=\"button\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 5h12v8H2zM1.5 2.5h13v2h-13zM6 8h4\"></path></svg>Archive</button></div><div class=\"ds-button-stage ds-light\"><button class=\"ds-action ds-action-light\" type=\"button\"><svg viewBox=\"0 0 16 16\" aria-hidden=\"true\"><path d=\"M2 5h12v8H2zM1.5 2.5h13v2h-13zM6 8h4\"></path></svg>Archive</button></div></div>",
      "css": ".ds-themes{display:grid;grid-template-columns:1fr 1fr;gap:8px;font:13px Geist,sans-serif}.ds-button-stage{padding:10px;border-radius:8px}.ds-dark{background:#060606;color:#e8e8ea}.ds-light{background:#fff;color:#303035}.ds-action{display:inline-flex;min-height:24px;align-items:center;gap:6px;padding:0 10px;border:1px solid #202020;border-radius:8px;background:#0e0e0e;color:#e8e8ea;font:13px Geist,sans-serif;cursor:pointer}.ds-action-light{border-color:#e5e5e9;background:#fff;color:#303035}.ds-action svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.4;stroke-linejoin:round}.ds-action-dark:hover{background:#252527}.ds-action-light:hover{background:#efeff2}.ds-action:focus-visible{outline:2px solid #7c86ff;outline-offset:2px}.ds-action-light:focus-visible{outline-color:#5b43e8}"
    },
    {
      "name": "Email reading pane",
      "kind": "custom",
      "refersTo": "message-reader-dark",
      "description": "Continuous reading surface with the implemented subject, sender, divider, and body hierarchy.",
      "html": "<div class=\"ds-themes\"><article class=\"ds-reader ds-dark\"><h2>The new identity system is ready</h2><div class=\"ds-author\"><span class=\"ds-avatar\">MC</span><span><strong>Maya Chen</strong><small>maya@northstar.example</small></span><time>10:42 AM</time></div><hr><p>Hi team,</p><p>I pulled the final typography and color studies into one clear direction. The new system feels calmer, but it still has enough character to stand on its own.</p><small class=\"ds-note\">Fictional sample content · no mailbox or network action is active.</small></article><article class=\"ds-reader ds-light\"><h2>The new identity system is ready</h2><div class=\"ds-author\"><span class=\"ds-avatar\">MC</span><span><strong>Maya Chen</strong><small>maya@northstar.example</small></span><time>10:42 AM</time></div><hr><p>Hi team,</p><p>I pulled the final typography and color studies into one clear direction. The new system feels calmer, but it still has enough character to stand on its own.</p><small class=\"ds-note\">Fictional sample content · no mailbox or network action is active.</small></article></div>",
      "css": ".ds-themes{display:grid;grid-template-columns:1fr 1fr;gap:8px;padding:8px;background:linear-gradient(135deg,#394254,#43384f);font-family:Geist,sans-serif}.ds-reader{box-sizing:border-box;max-width:680px;padding:24px}.ds-dark{background:rgb(6 6 6 / 95%);color:#e8e8ea}.ds-light{background:rgb(255 255 255 / 95%);color:#303035}.ds-reader h2{margin:0 0 20px;font-size:22px;font-weight:600;line-height:1.2}.ds-author{display:flex;align-items:center;gap:12px;font-size:13px}.ds-avatar{display:grid;width:36px;height:36px;flex:none;place-items:center;border-radius:9999px;background:#2e2e30;color:#a9a9ae;font-size:11px;font-weight:600}.ds-light .ds-avatar{background:#e8e8eb;color:#62626a}.ds-author strong,.ds-author small{display:block}.ds-author small,.ds-author time,.ds-note{color:#85858a;font-size:11px}.ds-light .ds-author small,.ds-light .ds-author time,.ds-light .ds-note{color:#73737a}.ds-author time{margin-left:auto}.ds-reader hr{height:1px;margin:24px 0;border:0;background:#202020}.ds-light hr{background:#e5e5e9}.ds-reader p{font-size:14px;line-height:1.5}.ds-note{display:block;margin-top:24px}"
    }
  ],
  "narrative": {
    "northStar": "Zeron’s quiet canvas, adapted to the three-pane mail workflow.",
    "overview": "MegaMail is a Linux desktop email client using official GPUI Kit 0.7.1. The desktop layout uses a 232px navigation rail, a 332px message list, and a continuous reading pane; rows are 78px high with 4px corners. The standalone MIT Zeron theme model at commit 0c4835d2b73aa632b7b4d626ee0826a25ec1c9b9 supplies 19 families and 30 variants. System mode follows the desktop appearance, Light and Dark selections are independent, and accent/surface settings can override the selected theme. Wallpaper processing is static and cached, with pane bleed capped at 24/10/5% by a theme-based contrast estimate. These materials do not implement Zeron’s renderer-specific backdrop blur or per-primitive edge fades. Current preview captures use fictional demo messages.",
    "keyCharacteristics": [
      "Continuous three-pane work surface with a quiet navigation rail and compact message list.",
      "78px email rows with 4px corners; hairlines and spacing define the panes instead of repeated cards.",
      "Nineteen built-in Zeron theme families with thirty variants, independent Light/Dark choices, and accent/surface overrides.",
      "Cached wallpaper treatments and theme-contrast-bounded pane tints."
    ],
    "rules": [
      {
        "name": "The Role Remap Rule",
        "body": "Keep semantic roles stable across modes and use each mode’s own value. Do not mechanically invert the dark palette.",
        "section": "colors"
      },
      {
        "name": "The Quiet Accent Rule",
        "body": "Keep indigo to focus, unread, star, and identity cues. Neutral fills carry large selected and hovered areas.",
        "section": "colors"
      },
      {
        "name": "The Tinted Pane Rule",
        "body": "Keep the 24/10/5% rail/list/reader bleed caps explicit; the selected theme contrast estimate may reduce them further.",
        "section": "elevation"
      },
      {
        "name": "The Static Material Rule",
        "body": "Cache wallpaper blur and treatments before painting. MegaMail does not implement Zeron renderer-specific backdrop blur or per-primitive edge fades.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the native palette values in the YAML as the source for text and tint roles; label Zeron source values separately.",
      "Do keep the reading pane continuous and reserve raised surfaces for controls and overlays.",
      "Do distinguish hover from selection, and pair unread weight with its dot cue.",
      "Do preserve the rail/list/reader wallpaper bleed caps.",
      "Do let the sampled custom-image contrast estimate reduce wallpaper opacity beneath text.",
      "Do keep keyboard navigation, Kit focus treatment, accessible action labels, and Linux caption behavior intact.",
      "Do distinguish live account state and operation results from sample-data visual fixtures.",
      "Do keep motion tied to changing state and honor reduced-motion settings if transitions are added.",
      "Do preserve Zeron source attribution and the license for every copied implementation or asset."
    ],
    "donts": [
      "Don’t wrap every pane or message row in a card.",
      "Don’t use accent as a large surface or rely on color alone for unread state.",
      "Don’t exceed the pane bleed caps or rely on a compositor effect for text contrast.",
      "Don’t imply web/mobile responsiveness or measured performance from this native desktop app.",
      "Don’t add idle decorative animation or copy Zeron icons without their license and attribution."
    ]
  }
}
