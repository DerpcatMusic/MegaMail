<?xml version="1.0"?>
<!-- Synthetic configuration: tests repeated auth choices, not provider approval. -->
<clientConfig version="1.1">
  <emailProvider id="yahoo.com">
    <domain>yahoo.com</domain>
    <displayName>Yahoo synthetic fixture</displayName>
    <incomingServer type="imap">
      <hostname>127.0.0.1</hostname><port>993</port><socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>[::1]</hostname><port>465</port><socketType>SSL</socketType>
      <authentication>OAuth2</authentication>
      <authentication>password-cleartext</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
</clientConfig>
