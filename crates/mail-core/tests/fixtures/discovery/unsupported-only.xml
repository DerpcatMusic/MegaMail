<?xml version="1.0"?>
<!-- Synthetic configuration: tests repeated auth choices, not provider approval. -->
<clientConfig version="1.1">
  <emailProvider id="yahoo.com">
    <domain>yahoo.com</domain>
    <displayName>Yahoo synthetic fixture</displayName>
    <incomingServer type="imap">
      <hostname>imap.mail.yahoo.com</hostname><port>993</port><socketType>SSL</socketType>
      <authentication>unknown-auth</authentication>
      <authentication>unknown-other-auth</authentication>
      <username>%EMAILADDRESS%</username>
    </incomingServer>
    <outgoingServer type="smtp">
      <hostname>smtp.mail.yahoo.com</hostname><port>465</port><socketType>SSL</socketType>
      <authentication>unknown-auth</authentication>
      <authentication>unknown-other-auth</authentication>
      <username>%EMAILADDRESS%</username>
    </outgoingServer>
  </emailProvider>
</clientConfig>
